{
    "name": "gitwed",
    "version": "1.3.1",
    "description": "Git-based website editor",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/mmoskal/gitwed.git"
    },
    "author": "Michal Moskal <michal@moskal.me>",
    "license": "MIT",
    "files": [
        "built",
        "gw",
        "gwcdn",
        "gitwed",
        "README.md"
    ],
    "bin": {
        "gitwed": "./gitwed"
    },
    "dependencies": {
        "@sendgrid/mail": "^8.1.6",
        "@types/express-rate-limit": "^5.1.3",
        "acme-client": "^5.4.0",
        "bluebird": "^3.7.2",
        "body-parser": "^1.20.5",
        "cheerio": "^1.2.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "express": "^4.22.1",
        "express-rate-limit": "^5.5.1",
        "htmlparser2": "^4.1.0",
        "jszip": "^3.10.1",
        "jwt-simple": "^0.5.6",
        "mailgun.js": "^13.0.1",
        "mime": "^2.6.0",
        "sharp": "^0.35.3",
        "winston": "^2.4.7"
    },
    "devDependencies": {
        "@types/bluebird": "^3.5.42",
        "@types/express": "^4.17.25",
        "@types/express-serve-static-core": "^4.19.8",
        "@types/jest": "^30.0.0",
        "@types/jquery": "^3.5.34",
        "@types/jszip": "3.4.1",
        "@types/jwt-simple": "^0.5.36",
        "@types/node": "^24.12.3",
        "@types/serve-static": "^1.15.10",
        "@types/winston": "^2.4.4",
        "form-data": "^4.0.5",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.9",
        "typescript": "^5.9.3"
    },
    "jest": {
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/server/tsconfig.json"
                }
            ]
        },
        "testMatch": [
            "<rootDir>/**/*.spec.ts"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json",
            "node"
        ]
    },
    "overrides": {
        "node-forge": "1.4.0",
        "@peculiar/x509": "1.13.0",
        "lodash": "4.18.1",
        "anymatch": {
            "picomatch": "2.3.2"
        }
    }
}
